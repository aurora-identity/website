<section class="hero-spotlight" aria-labelledby="hero-heading">
  <div class="hero-spotlight__inner">
    <p class="hero-spotlight__eyebrow">Shadow identity governance</p>
    <h1 class="hero-spotlight__headline" id="hero-heading">
      <span>Every AI identity in your org.</span>
      <span>Discovered. Owned. Governed.</span>
    </h1>
    <p class="hero-spotlight__lead">Aurora governs every identity your SSO doesn't — AI tools, service accounts, and shadow apps.</p>
    <div class="hero-spotlight__actions">
      <a class="btn btn-hero-primary hero-spotlight__cta" href="{{ site.repoUrl }}" target="_blank" rel="noopener noreferrer" data-cta>Deploy it yourself</a>
      <a class="btn btn-hero-secondary hero-spotlight__cta" href="{{ site.contactUrl }}" target="_blank" rel="noopener noreferrer">{{ en.cta.talkToUs }}</a>
    </div>
    <div class="hero-preview" aria-label="Aurora dashboard showing unmanaged identity risk">
      <div class="hero-preview__frame">
        <div class="hero-preview__glow" aria-hidden="true"></div>
        <div class="hero-preview__content">
          <div class="hero-preview__header">
            <p class="hero-preview__subhead">Aurora — live identity register and risk feed</p>
            <span class="hero-preview__badge">Live</span>
          </div>
          <div class="hero-preview__feed">
            <img class="hero-preview__image" src="/assets/images/hero-dashboard-quantified-risk.png" width="100%" alt="Aurora dashboard showing the identity register, ownership status, and risk scores" loading="lazy">
          </div>
        </div>
        <div class="hero-preview__cta">
          <span>→ Run this against your own environment</span>
          <a class="hero-preview__cta-link" href="{{ site.repoUrl }}" target="_blank" rel="noopener noreferrer" data-cta>{% include "github-icon.njk" %}{{ en.cta.getCode }}</a>
        </div>
      </div>
    </div>
  </div>
</section>
