{% set ctaId = "cta-demo-title-" + (page.fileSlug or "section") %}
{% set ctaTitleText = ctaTitle | default(site.brand.demoIntro, true) %}
{% set ctaSubtextText = ctaSubtext | default(site.brand.demoReassurance, true) %}
{% set ctaButtonHrefValue = ctaButtonHref | default(site.repoUrl, true) %}
{% set ctaButtonLabelText = ctaButtonLabel | default(en.cta.getCode, true) %}
{% set ctaButtonAriaLabelText = ctaButtonAriaLabel | default(ctaButtonLabelText, true) %}
{% set ctaButtonTargetValue = ctaButtonTarget | default('_blank', true) %}
{% set ctaButtonRelValue = ctaButtonRel | default('noopener noreferrer', true) %}
<section class="cta-demo">
  <div class="cta-demo__inner">
    <div class="cta-demo__terminal">
      <div class="cta-demo__terminal-bar">
        <span class="cta-demo__dot cta-demo__dot--r"></span>
        <span class="cta-demo__dot cta-demo__dot--a"></span>
        <span class="cta-demo__dot cta-demo__dot--g"></span>
        <span class="cta-demo__terminal-path">aurora — quickstart</span>
      </div>
      <div class="cta-demo__terminal-body">
        {% if ctaButtonHrefValue == site.repoUrl %}
        <p class="cta-demo__prompt">
          <span>git clone {{ site.repoUrl }}</span>
          <span>docker compose up --build <span class="cta-demo__cursor"></span></span>
        </p>
        {% endif %}
        <h2 id="{{ ctaId }}" class="cta-demo__title">{{ ctaTitleText | safe }}</h2>
        <p class="cta-demo__subtext">{{ ctaSubtextText }}</p>
        <div class="cta-demo__actions">
          <a class="cta-demo__button" data-cta href="{{ ctaButtonHrefValue }}" aria-label="{{ ctaButtonAriaLabelText }}" target="{{ ctaButtonTargetValue }}"{% if ctaButtonRelValue %} rel="{{ ctaButtonRelValue }}"{% endif %}>
            {% if ctaButtonHrefValue == site.repoUrl %}{% include "github-icon.njk" %}{% endif %}
            <span>{{ ctaButtonLabelText }}</span>
            <span aria-hidden="true">→</span>
          </a>
          {% if ctaButtonHrefValue != site.contactUrl %}
          <a href="{{ site.contactUrl }}" class="cta-demo__button-secondary" target="_blank" rel="noopener noreferrer">{{ en.cta.talkToUs }} ↗</a>
          {% endif %}
        </div>
        <p class="cta-demo__trust"><span aria-hidden="true">🔒</span> Open source · No sandbox · Your environment</p>
      </div>
    </div>
  </div>
</section>
