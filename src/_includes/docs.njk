<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ title or site.name }} — {{ site.tagline }}</title>
  <meta name="description" content="Identity-first discovery using email metadata, network logs and a browser extension. Identities surfaced when they first appear.">
  <meta name="robots" content="noindex, nofollow">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="Secure the unmanaged identities IAM and SSO can’t see. Privacy by design.">
  <meta property="og:type" content="website">
  <link rel="icon" type="image/x-icon" sizes="16x16" href="/assets/images/logo16.ico">
  <link rel="icon" type="image/x-icon" sizes="24x24" href="/assets/images/logo24.ico">
  <link rel="icon" type="image/x-icon" sizes="32x32" href="/assets/images/logo32.ico">
  <link rel="icon" type="image/x-icon" sizes="48x48" href="/assets/images/logo48.ico">
  <link rel="icon" type="image/x-icon" sizes="64x64" href="/assets/images/logo64.ico">
  <link rel="icon" type="image/x-icon" sizes="96x96" href="/assets/images/logo96.ico">
  <link rel="icon" type="image/x-icon" sizes="128x128" href="/assets/images/logo128.ico">
  <link rel="icon" type="image/x-icon" sizes="256x256" href="/assets/images/logo256.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/logo.png">
  <style>
    :root {
      --bg: #f8fafc;
      --panel: #ffffff;
      --border: #e2e8f0;
      --text: #0f172a;
      --muted: #475569;
      --accent: #0f52ba;
      --accent-soft: #e8f0ff;
    }
    .section-card img {
      width: 100%;
      height: auto;
      display: block;
    }
    .docs-shell *,
    .docs-shell *::before,
    .docs-shell *::after {
      box-sizing: border-box;
    }
    .docs-shell {
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: grid;
      grid-template-columns: 260px 1fr;
      gap: 32px;
      padding: 32px 40px 48px;
      font-family: "Inter", "Segoe UI", system-ui, -apple-system, sans-serif;
      font-size: 100%;
      width: min(1200px, 100% - 64px);
      margin: 0 auto;
    }
    .docs-nav {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 24px 20px;
      position: sticky;
      top: 24px;
      height: fit-content;
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    }
    .docs-nav h1 {
      font-size: 25px;
      margin: 0 0 16px;
      color: var(--accent);
    }
    .docs-nav h1 a {
      color: inherit;
      text-decoration: none;
    }
    .nav-section + .nav-section {
      margin-top: 18px;
      padding-top: 16px;
      border-top: 1px solid var(--border);
    }
    .nav-section h2 {
      font-size: 16px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--muted);
      margin: 0 0 10px;
    }
    .nav-section h2.h2-link a {
      font-size: 25px;
      margin: 0 0 16px;
      color: var(--accent);
      text-decoration: none;
      text-transform: none;
    }
    .nav-links {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .nav-links li {
      margin-bottom: 10px;
    }
    .nav-links a {
      text-decoration: none;
      color: var(--text);
      font-weight: 600;
      display: block;
      padding: 6px 8px;
      border-radius: 8px;
    }
    .nav-links a:hover,
    .nav-links a.active {
      color: var(--accent);
      background: var(--accent-soft);
    }
    .nav-links .indent {
      padding-left: 18px;
      font-weight: 500;
      color: var(--muted);
    }
    .docs-main {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 16px;
      box-shadow: 0 6px 16px rgba(15, 23, 42, 0.06);
      padding: 28px 32px;
      display: flex;
      flex-direction: column;
    }
    .section-card {
      background: transparent;
      border: none;
      border-radius: 0;
      padding: 0 0 28px;
      margin: 0;
      box-shadow: none;
    }
    .section-card + .section-card {
      border-top: 1px solid var(--border);
      padding-top: 28px;
    }
    .section-card h2 {
      margin: 0 0 12px;
      color: var(--accent);
      font-size: 28px;
    }
    .section-card h3 {
      margin-top: 12px;
      margin-bottom: 8px;
      color: var(--accent);
    }
    .section-card p {
      color: var(--muted);
      line-height: 1.6;
      margin: 0 0 12px;
    }
    .section-card ul,
    .section-card ol {
      color: var(--muted);
      line-height: 1.6;
      padding-left: 20px;
      margin: 0 0 8px;
    }
    .callout {
      background: var(--accent-soft);
      border: 1px solid #d6e4ff;
      color: var(--text);
      border-radius: 12px;
      padding: 14px 16px;
      margin-top: 12px;
    }
    code {
      background: #eef2ff;
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 90%;
    }
    pre {
      background: #0f172a;
      color: #e5e7eb;
      padding: 16px;
      border-radius: 12px;
      overflow-x: auto;
      border: 1px solid #1f2937;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04), 0 10px 30px rgba(0, 0, 0, 0.25);
      line-height: 1.6;
      font-family: "SFMono-Regular", Menlo, Consolas, "Liberation Mono", monospace;
      font-size: 0.92em;
    }
    pre code {
      background: transparent;
      color: inherit;
      display: block;
      padding: 0;
      margin: 0;
    }
  </style>
</head>
<html>
  <div class="docs-shell">
    {% include "docs-nav.njk" %}
    <main class="docs-main">
      {{ content | safe }}
    </main>
  </div>
</html>
